<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- The sibling repositories in this workspace pack into local artifacts folders, and a
       machine that has one of those registered as a source will restore that build of ninep
       instead of the published one, silently. Clearing inherited sources means what this
       repository builds against is what a stranger cloning it builds against. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

</configuration>
